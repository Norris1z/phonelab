apiVersion: k0s.k0sproject.io/v1beta1
kind: ClusterConfig
metadata:
  name: k0s
spec:
  api:
    address: {{ node_ip }}
    externalAddress: {{ node_ip }}
  storage:
    type: kine
  controllerManager:
    extraArgs:
      node-monitor-grace-period: 2m
  workerProfiles:
    - name: phone
      values:
        nodeStatusUpdateFrequency: 30s
        nodeLeaseDurationSeconds: 120
        syncFrequency: 3m
        fileCheckFrequency: 2m
