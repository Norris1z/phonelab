    {
      "id": 29,
      "type": "table",
      "title": "Nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory requested"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory requested"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.8
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Yes",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "No",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (kube_node_status_condition{condition=\"Ready\",status=\"true\"}) * on(node) group_left(os_image, kernel_version, kubelet_version) kube_node_info",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (node) (kube_pod_info) * on(node) group_left(os_image, kernel_version, kubelet_version) kube_node_info",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"cpu\"}) * on(node) group_left(os_image, kernel_version, kubelet_version) kube_node_info",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"memory\"}) * on(node) group_left(os_image, kernel_version, kubelet_version) kube_node_info",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"memory\"}) / on(node) kube_node_status_allocatable{resource=\"memory\"} * on(node) group_left(os_image, kernel_version, kubelet_version) kube_node_info",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "ready",
              "Value #B": "pods",
              "Value #C": "cpu",
              "Value #D": "memory",
              "Value #E": "requested"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "node": true,
              "ready": true,
              "os_image": true,
              "kernel_version": true,
              "kubelet_version": true,
              "pods": true,
              "cpu": true,
              "memory": true,
              "requested": true
            },
            "indexByName": {
              "node": 0,
              "ready": 1,
              "os_image": 2,
              "kernel_version": 3,
              "kubelet_version": 4,
              "pods": 5,
              "cpu": 6,
              "memory": 7,
              "requested": 8
            },
            "renameByName": {
              "node": "Node",
              "ready": "Ready",
              "os_image": "OS",
              "kernel_version": "Kernel",
              "kubelet_version": "Kubelet",
              "pods": "Pods",
              "cpu": "CPUs",
              "memory": "Memory",
              "requested": "Memory requested"
            }
          }
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 10
      }
