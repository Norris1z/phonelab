          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, instance) (scrape_samples_scraped)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "up",
              "Value #B": "duration",
              "Value #C": "samples"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "job": true,
              "instance": true,
              "up": true,
              "duration": true,
              "samples": true
            },
            "indexByName": {
              "job": 0,
              "instance": 1,
              "up": 2,
              "duration": 3,
              "samples": 4
            },
            "renameByName": {
              "job": "Job",
              "instance": "Instance",
              "up": "Up",
              "duration": "Scrape time",
              "samples": "Samples"
            }
          }
        }
