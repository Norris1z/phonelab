        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{container!=\"\",container!=\"POD\",namespace=\"flux-system\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 25
      }
    }
  ]
