      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (controller) (increase(controller_runtime_reconcile_errors_total[1h])) > 0",
          "legendFormat": "{{controller}}"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 25
      }
    },
    {
      "id": 48,
      "type": "timeseries",
      "title": "Controller memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
