        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      }
    },
    {
      "id": 44,
      "type": "table",
      "title": "Resources",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "True": {
                        "text": "True",
                        "color": "green",
                        "index": 0
                      },
                      "False": {
                        "text": "False",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Suspended"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "True": {
                        "text": "True",
                        "color": "orange",
                        "index": 0
                      },
                      "False": {
                        "text": "False",
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Ready",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "flux_resource_info",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "x"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "kind": true,
              "exported_namespace": true,
              "name": true,
              "ready": true,
              "reason": true,
              "revision": true,
              "suspended": true
            },
            "indexByName": {
              "kind": 0,
              "exported_namespace": 1,
              "name": 2,
              "ready": 3,
              "reason": 4,
              "revision": 5,
              "suspended": 6
            },
            "renameByName": {
              "kind": "Kind",
              "exported_namespace": "Namespace",
              "name": "Name",
              "ready": "Ready",
              "reason": "Reason",
              "revision": "Revision",
              "suspended": "Suspended"
            }
          }
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 50,
      "type": "row",
      "title": "Reconciliation",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      }
    },
    {
      "id": 45,
      "type": "timeseries",
      "title": "Average reconcile duration (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind, name) (increase(gotk_reconcile_duration_seconds_sum[1h])) / sum by (kind, name) (increase(gotk_reconcile_duration_seconds_count[1h]))",
          "legendFormat": "{{kind}} {{name}}"
        }
      ],
      "description": "Flux reconciles every 10 minutes, so this averages over the last hour",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 46,
      "type": "timeseries",
      "title": "Reconciles per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
